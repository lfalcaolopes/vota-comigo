PORT=3001
DATABASE_URL=postgresql://vota_comigo:vota_comigo@localhost:5432/vota_comigo
# Allowed CORS origin(s), comma-separated. Required in production (the real web
# domain); otherwise the browser is blocked. Defaults to http://localhost:3000.
WEB_ORIGIN=http://localhost:3000
# OPENROUTER_API_KEY is used by the resumo-IA ingestion CLIs and by the HTTP
# server, which embeds the search query. Without it the search degrades to the
# token filter instead of ranking semantically.
OPENROUTER_API_KEY=
# Chat model, used only by the resumo-IA generation CLI.
OPENROUTER_MODEL=
# Embedding model for proposicao search. Defaults to openai/text-embedding-3-small.
OPENROUTER_EMBEDDING_MODEL=
# Sentry only initializes when SENTRY_DSN is set AND NODE_ENV=production,
# so leaving it blank keeps dev and tests from sending events.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
